{
  "schema_version": "2.0.0",
  "export_type": "equivalent_reference_config",
  "native_export": false,
  "direct_import_supported": false,
  "status": "local_verified_pending_coze_native_update",
  "disclaimer_zh": "此文件是 Coze 节点等价参考配置，不是平台原生导出。日化迁移已完成本地复算，尚未冒充为 Coze 平台原生运行。",
  "project": {
    "name": "智选 Agent｜日化历史数据 Coze MVP",
    "platform": "Coze（扣子）",
    "language": "zh-CN",
    "publication_status": "未部署",
    "platform_project_id": "7679015075092578350",
    "platform_project_url": "https://code.coze.cn/p/7679015075092578350/preview",
    "interaction_contract": "保留 Start→需求抽取→归一化→必填判断→单问题追问/检索→排序→理由→事实校验→统一输出的原有交互结构",
    "implementation_status": "日化等价配置与离线验证已完成；Coze 画布、Secret 和原生运行待在平台内同步"
  },
  "doubao": {
    "provider": "火山方舟豆包",
    "purpose": "只抽取需求字段，不生成商品事实或价格",
    "secret_ref": "ARK_API_KEY",
    "model_ref": "ARK_MODEL",
    "base_url_ref": "ARK_BASE_URL",
    "default_model": "doubao-seed-2-0-lite-260215",
    "credential_policy": "真实密钥只放在 Coze Secret 或部署环境变量，不进入代码、日志、输出或 Git 历史。",
    "integration_state": "configuration_ready_secret_not_provisioned"
  },
  "assets": {
    "catalog_path": "../data/products.json",
    "catalog_version": "2.0.0",
    "catalog_historical": true,
    "price_field": "sample_price",
    "price_label": "样本价",
    "categories": ["补水喷雾", "保湿乳霜", "清洁定妆"],
    "rule_version": "daily_rule_v1",
    "evidence_policy": "敏感肌或成分避雷需求必须通过 official_current_reference 证据门槛。"
  },
  "input_schema": {
    "type": "object",
    "required": ["query"],
    "properties": {"query": {"type": "string", "minLength": 1}}
  },
  "output_schema": {
    "type": "object",
    "required": ["status", "parsed", "missing_fields", "question", "recommendations", "fallback", "trace"],
    "properties": {
      "status": {"enum": ["need_clarification", "recommend", "no_result"]},
      "parsed": {
        "type": "object",
        "required": ["category", "budget", "use_case", "priority", "skin_type", "avoid_ingredients", "requires_verified_evidence"],
        "properties": {
          "category": {"type": ["string", "null"]},
          "budget": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "use_case": {"type": "array", "items": {"type": "string"}},
          "priority": {"type": "array", "items": {"type": "string"}},
          "skin_type": {"type": ["string", "null"]},
          "avoid_ingredients": {"type": "array", "items": {"type": "string"}},
          "requires_verified_evidence": {"type": "boolean"}
        }
      },
      "missing_fields": {"type": "array", "items": {"type": "string"}},
      "question": {"type": ["string", "null"]},
      "recommendations": {"type": "array"},
      "fallback": {"type": ["object", "null"]},
      "trace": {"type": "object"}
    }
  },
  "graph": {
    "nodes": [
      {
        "id": "start",
        "name": "Start",
        "coze_node_type": "start",
        "inputs": ["query"],
        "outputs": ["query"],
        "config": {"trim_input": true, "reject_empty": true}
      },
      {
        "id": "intent_extract",
        "name": "IntentExtract",
        "coze_node_type": "llm_or_http",
        "inputs": ["start.query"],
        "outputs": ["raw_intent"],
        "config": {
          "provider": "火山方舟豆包",
          "credential": {"type": "secret_ref", "name": "ARK_API_KEY"},
          "model": {"type": "environment_ref", "name": "ARK_MODEL", "default": "doubao-seed-2-0-lite-260215"},
          "base_url": {"type": "environment_ref", "name": "ARK_BASE_URL", "default": "https://ark.cn-beijing.volces.com/api/v3"},
          "response_mode": "strict_json",
          "system_prompt": "你是日化导购需求抽取器。只抽取用户显式表达的品类、预算、功效、肤质和需避开成分，不猜测配方、安全性、商品事实或价格。只输出固定 JSON 字段。"
        }
      },
      {
        "id": "normalize_fields",
        "name": "NormalizeFields",
        "coze_node_type": "code",
        "inputs": ["intent_extract.raw_intent"],
        "outputs": ["parsed"],
        "config": {
          "category_aliases": {
            "喷雾": "补水喷雾", "化妆水喷雾": "补水喷雾", "补水喷雾": "补水喷雾",
            "乳液": "保湿乳霜", "面霜": "保湿乳霜", "保湿乳霜": "保湿乳霜",
            "洁面": "清洁定妆", "卸妆": "清洁定妆", "散粉": "清洁定妆", "定妆": "清洁定妆"
          },
          "avoid_aliases": {"香精/香料": "香精", "paraben/防腐酯": "对羟基苯甲酸酯", "酒精/乙醇": "酒精", "矿物油": "矿物油", "SLS": "SLS", "SLES": "SLES"},
          "rules": ["预算只接受正数上限", "敏感肌或成分避雷使 requires_verified_evidence=true", "未显式表达的字段保持 null 或空数组"]
        }
      },
      {
        "id": "required_fields",
        "name": "RequiredFields",
        "coze_node_type": "condition",
        "inputs": ["normalize_fields.parsed"],
        "outputs": ["complete", "missing_fields"],
        "config": {"required": ["category", "budget", "use_case"], "priority_order": ["category", "budget", "use_case"]}
      },
      {
        "id": "clarify_one_field",
        "name": "ClarifyOneField",
        "coze_node_type": "code",
        "inputs": ["required_fields.missing_fields", "normalize_fields.parsed"],
        "outputs": ["question", "clarified_field"],
        "config": {"one_question_only": true, "question_templates": {"category": "你想找补水喷雾、保湿乳霜，还是清洁定妆产品？", "budget": "你的样本价预算上限是多少？", "use_case": "你最在意补水、保湿、控油还是清洁？"}}
      },
      {
        "id": "retrieve_catalog",
        "name": "RetrieveCatalog",
        "coze_node_type": "code",
        "inputs": ["normalize_fields.parsed", "assets.catalog"],
        "outputs": ["eligible", "excluded_by_category", "excluded_by_budget", "excluded_by_evidence", "same_category_total_count"],
        "config": {
          "hard_filters": ["category == parsed.category", "sample_price <= parsed.budget", "敏感肌时 official_current_reference 且 sensitive_skin_claim=true", "成分避雷时每一项都必须出现在官方 formulated_without"],
          "null_policy": "历史销量或评论缺失时保持 null，排序归一化时按 0 处理，不伪造观测值"
        }
      },
      {
        "id": "has_candidates",
        "name": "HasCandidates",
        "coze_node_type": "condition",
        "inputs": ["retrieve_catalog.eligible"],
        "outputs": ["yes", "no"],
        "config": {"condition": "len(eligible) > 0"}
      },
      {
        "id": "rule_rank_v1",
        "name": "RuleRankDailyV1",
        "coze_node_type": "code",
        "inputs": ["retrieve_catalog.eligible", "normalize_fields.parsed"],
        "outputs": ["ranked_top3"],
        "config": {
          "formula": "0.40*need_match + 0.20*budget_match + 0.15*historical_sales_normalized + 0.10*historical_comments_normalized + 0.15*evidence_quality",
          "score_range": [0, 100],
          "stable_sort": ["score desc", "historical_sales_count desc", "sample_price asc", "id asc"],
          "top_k": 3
        }
      },
      {
        "id": "reason_generate",
        "name": "ReasonGenerate",
        "coze_node_type": "llm",
        "inputs": ["rule_rank_v1.ranked_top3", "normalize_fields.parsed"],
        "outputs": ["draft_reasons"],
        "config": {"model": "同 IntentExtract 的 ARK_MODEL Secret 配置", "prompt_guardrails": ["只改写输入字段", "不生成库外商品", "不把样本价写成电商平台报价", "不把商家标题功效词升级为官方证据", "不对过敏或医疗结果作保证"]}
      },
      {
        "id": "fact_guard",
        "name": "FactGuard",
        "coze_node_type": "code",
        "inputs": ["rule_rank_v1.ranked_top3", "reason_generate.draft_reasons", "assets.catalog"],
        "outputs": ["recommendations"],
        "config": {"checks": ["id/shop/name/sample_price 必须与商品库一致", "budget_gap == budget - sample_price", "敏感肌与避雷断言必须有官方来源", "tradeoff 必须来自 limitations"], "on_failure": "丢弃不通过项并返回证据不足说明"}
      },
      {
        "id": "no_result_fallback",
        "name": "NoResultFallback",
        "coze_node_type": "code",
        "inputs": ["retrieve_catalog", "normalize_fields.parsed"],
        "outputs": ["fallback"],
        "config": {"logic": ["有同品类预算内商品但均未通过证据门槛时返回 insufficient_verified_evidence", "预算低于同品类最低样本价时返回 budget_below_sample_floor", "品类未覆盖时返回 category_not_covered"]}
      },
      {
        "id": "build_response",
        "name": "BuildResponse",
        "coze_node_type": "code",
        "inputs": ["normalize_fields.parsed", "required_fields", "clarify_one_field", "fact_guard", "no_result_fallback", "retrieve_catalog"],
        "outputs": ["status", "parsed", "missing_fields", "question", "recommendations", "fallback", "trace"],
        "config": {
          "branch_mappings": {
            "need_clarification": {"status": "need_clarification", "parsed": "normalize_fields.parsed", "missing_fields": "required_fields.missing_fields", "question": "clarify_one_field.question", "recommendations": [], "fallback": null, "trace": "trace_mapping"},
            "recommend": {"status": "recommend", "parsed": "normalize_fields.parsed", "missing_fields": [], "question": null, "recommendations": "fact_guard.recommendations", "fallback": null, "trace": "trace_mapping"},
            "no_result": {"status": "no_result", "parsed": "normalize_fields.parsed", "missing_fields": [], "question": null, "recommendations": [], "fallback": "no_result_fallback.fallback", "trace": "trace_mapping"}
          },
          "trace_mapping": {
            "source_nodes": {
              "rule_version": "assets", "catalog_version": "assets", "retrieval_executed": "build_response", "eligible_count": "retrieve_catalog", "returned_count": "build_response", "excluded_by_category": "retrieve_catalog", "excluded_by_budget": "retrieve_catalog", "excluded_by_evidence": "retrieve_catalog", "same_category_total_count": "retrieve_catalog", "clarified_field": "clarify_one_field"
            }
          },
          "invariant": "三种分支始终返回七个统一顶层字段"
        }
      },
      {
        "id": "end",
        "name": "End",
        "coze_node_type": "end",
        "inputs": ["build_response"],
        "outputs": ["status", "parsed", "missing_fields", "question", "recommendations", "fallback", "trace"],
        "config": {"field_mapping": {"status": "build_response.status", "parsed": "build_response.parsed", "missing_fields": "build_response.missing_fields", "question": "build_response.question", "recommendations": "build_response.recommendations", "fallback": "build_response.fallback", "trace": "build_response.trace"}}
      }
    ],
    "edges": [
      {"from": "start", "to": "intent_extract"},
      {"from": "intent_extract", "to": "normalize_fields"},
      {"from": "normalize_fields", "to": "required_fields"},
      {"from": "required_fields.incomplete", "to": "clarify_one_field"},
      {"from": "clarify_one_field", "to": "build_response"},
      {"from": "required_fields.complete", "to": "retrieve_catalog"},
      {"from": "retrieve_catalog", "to": "has_candidates"},
      {"from": "has_candidates.no", "to": "no_result_fallback"},
      {"from": "no_result_fallback", "to": "build_response"},
      {"from": "has_candidates.yes", "to": "rule_rank_v1"},
      {"from": "rule_rank_v1", "to": "reason_generate"},
      {"from": "reason_generate", "to": "fact_guard"},
      {"from": "fact_guard", "to": "build_response"},
      {"from": "build_response", "to": "end"}
    ]
  },
  "verification": {
    "local_examples": "../examples/input-output.json",
    "local_test_report": "../examples/test-report.md",
    "coze_native_run_verified": false,
    "coze_native_export_attached": false,
    "evidence_attached": false,
    "reason": "当前会话只修改 GitHub 子项目，未获授权登录 Coze 平台改画布、配置 Secret 或执行原生调用。"
  }
}
